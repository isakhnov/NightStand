<?xml version="1.0" encoding="utf-8"?>
<!-- Smart photos: embeddings, swipes and the model stay on this phone (privacy + size). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="photos_smart.db" />
        <exclude domain="database" path="photos_smart.db-wal" />
        <exclude domain="database" path="photos_smart.db-shm" />
        <exclude domain="file" path="models/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="photos_smart.db" />
        <exclude domain="database" path="photos_smart.db-wal" />
        <exclude domain="database" path="photos_smart.db-shm" />
        <exclude domain="file" path="models/" />
    </device-transfer>
</data-extraction-rules>
